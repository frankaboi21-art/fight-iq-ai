ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Set a unique random invitation code of at least 20 characters. Never use your API key here.
BETA_ACCESS_CODE=
COACH_HOURLY_LIMIT=10
COACH_DAILY_LIMIT=30
SESSION_HOURS=8
USAGE_DB_PATH=.data/usage.sqlite3
# Leave blank on Render to use its RENDER_EXTERNAL_URL, or set the final HTTPS origin.
PUBLIC_ORIGIN=
# Persistent PostgreSQL connection string; required for saved accounts in production.
# Set securely in Render. Never commit a real value.
DATABASE_URL=
# Development/test fallback only; production never falls back to ephemeral SQLite.
TRAINING_DB_PATH=.data/training.sqlite3
